  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2fa61a36d07c29f49942915a8c641e9e, type: 3}
  m_Name: Vacationer_IntroDialogue
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  requiredFlag: 
  lines:
  - speakerName: Vacationer
    speakerPortrait: {fileID: 5495316049830206490, guid: af3e03d075a8238498e997b39f4b5410, type: 3}
    text: Careful on the black ice, friend! The wind off Cape Farewell has been blowing
      wreckage ashore all morning.
    voiceOrFoleyClip: {fileID: 0}
  - speakerName: Vacationer
    speakerPortrait: {fileID: 5495316049830206490, guid: af3e03d075a8238498e997b39f4b5410, type: 3}
    text: Something metallic is bobbing out near the surf...
    voiceOrFoleyClip: {fileID: 0}
  - speakerName: Vacationer
    speakerPortrait: {fileID: 5495316049830206490, guid: af3e03d075a8238498e997b39f4b5410, type: 3}
    text: 'and I spotted scattered fishing gear and boat supplies along the rocks.  '
    voiceOrFoleyClip: {fileID: 0}
  - speakerName: Vacationer
    speakerPortrait: {fileID: 5495316049830206490, guid: af3e03d075a8238498e997b39f4b5410, type: 3}
    text: "Gather what you need and rig a fishing pole\u2014let's see what washed
      in!"
    voiceOrFoleyClip: {fileID: 0}
  highPenaltyLines: []
  flagToSetWhenFinished: metVacationer
